# =============================================================================
# .gitignore — Healthcare Data Analysis Portfolio Project
# =============================================================================

# PostgreSQL Runtime & Cluster Data
.pgdata/
*.pid
server.log
logfile
*.dump
*.backup
*.sql.gz

# Python Bytecode & Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Cache
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Sensitive Information & Credentials
.env
.env.*
*.pem
*.key
*.cert
credentials.json
secrets.yaml
config.local.json

# Operating System & IDE Files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*~

# Temporary Scratch Files
scratch/
tmp/
*.tmp

